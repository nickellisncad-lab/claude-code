# ---- Letterboxd ------------------------------------------------------------
# Comma-separated usernames. Their watchlists must be publicly visible.
LETTERBOXD_USERS=nickelliis,karlasalgadox

# ---- Radarr ----------------------------------------------------------------
# Base URL, no trailing /api. Use the container name if both are in Docker.
RADARR_URL=http://radarr:7878
# Radarr > Settings > General > Security > API Key
RADARR_API_KEY=changeme
# Must exactly match a path from Radarr > Settings > Media Management.
RADARR_ROOT_FOLDER=/movies
# Profile name (case-insensitive) or numeric id.
RADARR_QUALITY_PROFILE=HD-1080p

# announced | inCinemas | released
RADARR_MINIMUM_AVAILABILITY=released
# Monitor the movie after adding it.
RADARR_MONITOR=true
# Kick off a search immediately on add. Set false to just queue it up.
RADARR_SEARCH_ON_ADD=true
# Optional comma-separated Radarr tags, created if they do not exist.
RADARR_TAGS=letterboxd

# ---- Throttling ------------------------------------------------------------
# Never let Radarr have more than this many items in its download queue
# because of us. 1 = strictly one movie at a time. 0 = no limit.
# If the queue is full, new films are held and retried on the next pass.
# Only meaningful when RADARR_SEARCH_ON_ADD=true.
MAX_ACTIVE_DOWNLOADS=1

# Hard cap on how many movies a single pass may add, whatever the queue says.
# 0 = no limit. Belt-and-braces against a big batch of watchlist additions.
MAX_ADDS_PER_RUN=1

# ---- Behaviour -------------------------------------------------------------
# Seconds between checks. Minimum 60. 3600 = hourly, 86400 = once a day.
# Note this interacts with MAX_ADDS_PER_RUN: at one add per pass, a daily
# poll drains a backlog at one film per day.
POLL_INTERVAL=3600

# true  = on the very first run, record both existing watchlists as the
#         baseline and request nothing. Only later additions get sent.
# false = import everything currently on both watchlists on the first run.
SEED_ON_FIRST_RUN=true

# Log what would be requested without writing anything to Radarr.
DRY_RUN=false

# Seconds between Letterboxd requests. Please do not lower this much.
REQUEST_DELAY=1.0

STATE_PATH=/data/state.db
LOG_LEVEL=INFO
